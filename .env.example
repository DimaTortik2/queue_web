# URL бэкенда (например: https://api.yourdomain.com)
VITE_API_BASE_URL=

# Необязательно. Если не указан, автоматически формируется из VITE_API_BASE_URL
# Например: wss://api.yourdomain.com
# VITE_WS_BASE_URL=

# Telegram Bot username (например: my_queue_bot или @my_queue_bot)
# Необходим для формирования кликабельных deep link ссылок вида t.me/bot_name?startapp=...
VITE_TELEGRAM_BOT_USERNAME=

# Необязательно: Короткое имя Mini App (если создано через BotFather -> /newapp)
# Если указано, ссылки будут формироваться вида: t.me/bot_name/app_name?startapp=...
# VITE_TELEGRAM_APP_NAME=
