# URL бэкенда (например: https://api.yourdomain.com)
VITE_API_BASE_URL=

# Telegram Mini App initData must be verified by the backend with the bot token.
# Keep TELEGRAM_BOT_TOKEN in the backend .env only. Never expose it with a VITE_ prefix.

# Необязательно. Если не указан, автоматически формируется из VITE_API_BASE_URL
# Например: wss://api.yourdomain.com
# VITE_WS_BASE_URL=

# Адрес Telegram Mini App для прямых ссылок на очереди
VITE_TMA_URL=https://t.me/queue_college_bot/queue

# Telegram Bot username (например: queue_college_bot)
# Используется, если VITE_TMA_URL не задан (по умолчанию: queue_college_bot)
VITE_TELEGRAM_BOT_USERNAME=queue_college_bot

# Короткое имя Mini App, если оно не указано в VITE_TMA_URL
VITE_TELEGRAM_APP_NAME=queue
